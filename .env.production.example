# Kalico - production environment template
# Copy this file to .env.production.local and replace every placeholder
# with a fresh secret before deploying.

NODE_ENV=production
BASE_URL=https://kalico.nc
DOMAIN=kalico.nc
DEPLOY_PATH=/opt/kalico
REPO_URL=https://github.com/Kalico-nc/kalico-safe-export.git
NEXT_PUBLIC_API_URL=https://kalico.nc/api
NEXT_PUBLIC_SITE_URL=https://kalico.nc
EXPO_PUBLIC_API_URL=https://kalico.nc/api
NEXT_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_DEMO_MODE=false
DEMO_MODE=false
RUN_JOBS=true

# App / admin
ADMIN_EMAIL=admin@kalico.nc
ADMIN_PASSWORD_HASH=CHANGE_ME_ADMIN_PASSWORD_HASH
ADMIN_TOTP_SECRET=CHANGE_ME_ADMIN_TOTP_SECRET
ADMIN_API_TOKEN=CHANGE_ME_ADMIN_API_TOKEN
ADMIN_ALERT_EMAIL=admin@kalico.nc
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET_MIN_64_CHARS
NEXTAUTH_URL=https://admin.kalico.nc

# Docker images
BACKEND_IMAGE=ghcr.io/Kalico-nc/kalico-safe-export/backend:latest
FRONTEND_IMAGE=ghcr.io/Kalico-nc/kalico-safe-export/frontend:latest

# Database
PORT=3001
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=kalico_prod
DB_USER=kalico
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_POOL_MAX=10
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_RESERVE_POOL_SIZE=20
PGBOUNCER_SERVER_IDLE_TIMEOUT=600

# Redis
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Auth / sessions
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_API_TOKEN

# Frontend public flags
NEXT_PUBLIC_STRIPE_PK=CHANGE_ME_PUBLIC_STRIPE_PK
NEXT_PUBLIC_SHOW_DEMO_BAR=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=CHANGE_ME_PUBLIC_GOOGLE_CLIENT_ID
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME_PUBLIC_TURNSTILE_SITE_KEY
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=CHANGE_ME_PRICE_PRO_MONTHLY
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=CHANGE_ME_PRICE_PRO_YEARLY
NEXT_PUBLIC_PAYPLUG_PLAN_PRO_MONTHLY=CHANGE_ME_PAYPLUG_PLAN_PRO_MONTHLY
NEXT_PUBLIC_PAYPLUG_PLAN_PRO_YEARLY=CHANGE_ME_PAYPLUG_PLAN_PRO_YEARLY
NEXT_PUBLIC_STRIPE_PRICE_PRO_PLUS_MONTHLY=CHANGE_ME_PRICE_PRO_PLUS_MONTHLY
NEXT_PUBLIC_STRIPE_PRICE_PRO_PLUS_YEARLY=CHANGE_ME_PRICE_PRO_PLUS_YEARLY
NEXT_PUBLIC_PAYPLUG_PLAN_PRO_PLUS_MONTHLY=CHANGE_ME_PAYPLUG_PLAN_PRO_PLUS_MONTHLY
NEXT_PUBLIC_PAYPLUG_PLAN_PRO_PLUS_YEARLY=CHANGE_ME_PAYPLUG_PLAN_PRO_PLUS_YEARLY

# Backend integrations
AWS_BUCKET=CHANGE_ME_AWS_BUCKET
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM=noreply@kalico.nc
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_PRO_MENSUEL=CHANGE_ME_STRIPE_PRICE_PRO_MENSUEL
STRIPE_PRICE_PRO_ANNUEL=CHANGE_ME_STRIPE_PRICE_PRO_ANNUEL
PAYPLUG_SECRET_KEY=CHANGE_ME_PAYPLUG_SECRET_KEY
PAYPLUG_WEBHOOK_SECRET=CHANGE_ME_PAYPLUG_WEBHOOK_SECRET
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SID=CHANGE_ME_TWILIO_VERIFY_SID
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
APPLE_CLIENT_ID=CHANGE_ME_APPLE_CLIENT_ID
APPLE_TEAM_ID=CHANGE_ME_APPLE_TEAM_ID
APPLE_KEY_ID=CHANGE_ME_APPLE_KEY_ID
APPLE_PRIVATE_KEY=CHANGE_ME_APPLE_PRIVATE_KEY

# Local runtime
MAX_FILE_SIZE_MB=10
MAX_IMAGES_PER_LISTING=8
STORAGE_LOCAL_PATH=/app/uploads
EXPO_ACCESS_TOKEN=CHANGE_ME_EXPO_ACCESS_TOKEN
EXPO_PUBLIC_PROJECT_ID=CHANGE_ME_EXPO_PUBLIC_PROJECT_ID
NEXT_STANDALONE=1
