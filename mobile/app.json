{
  "expo": {
    "name": "Kalico",
    "slug": "kalico-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kalico",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A7EA4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nc.kalico.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:kalico.nc"
      ],
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "51.255.161.64.nip.io": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "NSCameraUsageDescription": "Kalico utilise votre caméra pour prendre des photos de vos annonces.",
        "NSPhotoLibraryUsageDescription": "Kalico accède à vos photos pour illustrer vos annonces.",
        "NSMicrophoneUsageDescription": "Kalico utilise votre micro pour envoyer des messages vocaux.",
        "NSLocationWhenInUseUsageDescription": "Kalico utilise votre position pour afficher les annonces proches.",
        "NSUserNotificationsUsageDescription": "Kalico vous envoie des notifications pour vos messages et annonces.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A7EA4"
      },
      "package": "nc.kalico.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kalico.nc",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0A7EA4",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kalico accède à vos photos pour illustrer vos annonces."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.nc.kalico.app",
          "enableGooglePay": true
        }
      ],
      "expo-apple-authentication",
      "expo-asset",
      "expo-font",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b886f93a-0106-4d5b-82df-3ad6eefe9ea5"
      }
    },
    "owner": "kaliconc"
  }
}
